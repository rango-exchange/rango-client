{
  "name": "@rango-dev/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "source": "./src/mod.ts",
  "main": "./dist/mod.js",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "typings": "./dist/mod.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@hub3js/core": "^0.62.0",
    "@hub3js/evm": "0.0.0-experimental-86ac55e4-20260902",
    "@hub3js/namespaces": "0.0.0-experimental-86ac55e4-20260902",
    "bignumber.js": "^9.1.1",
    "rango-sdk": "^0.5.0",
    "rango-types": "0.0.0-experimental-4602126c-20260902"
  },
  "scripts": {
    "build": "yarn run rangutopia library build --inputs src/mod.ts",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": "*",
    "xrpl": "*"
  },
  "peerDependenciesMeta": {
    "@stellar/stellar-sdk": {
      "optional": true
    },
    "xrpl": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^15.0.1",
    "xrpl": "^4.2.0"
  }
}
