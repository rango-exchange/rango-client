{
  "name": "@rango-dev/widget-app",
  "version": "0.29.1",
  "license": "MIT",
  "private": true,
  "source": "public/index.html",
  "main": "dist/index.html",
  "targets": {
    "main": false
  },
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "scripts": {
    "dev": "parcel -p 3002 --cache-dir=.parcel-cache --no-cache",
    "build": "parcel build --cache-dir=.parcel-cache",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf .parcel-cache && rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "parcel": "^2.16.4",
    "vm-browserify": "^1.1.2"
  },
  "dependencies": {
    "@hub3js/core": "^0.64.0",
    "@hub3js/namespaces": "^0.8.0",
    "@rango-dev/logging-console": "^0.15.1-next.1",
    "@rango-dev/logging-subscriber": "^0.15.1-next.1",
    "@rango-dev/provider-all": "^0.67.1-next.1",
    "@rango-dev/wallets-react": "^0.50.1-next.1",
    "@rango-dev/widget-embedded": "^0.65.1-next.1",
    "rango-types": "^0.6.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0"
  }
}
