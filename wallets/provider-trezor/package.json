{
  "name": "@rango-dev/provider-trezor",
  "version": "0.27.1-next.4",
  "license": "MIT",
  "type": "module",
  "source": "./src/mod.ts",
  "main": "./dist/mod.js",
  "exports": {
    ".": "./dist/mod.js"
  },
  "typings": "dist/mod.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build/command.mjs --path wallets/provider-trezor --splitting --inputs src/mod.ts",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@rango-dev/signer-evm": "^0.42.1-next.0",
    "@rango-dev/wallets-shared": "^0.60.1-next.3",
    "@trezor/connect-web": "^9.5.0",
    "ethers": "^6.13.2",
    "rango-types": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
