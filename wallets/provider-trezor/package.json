{
  "name": "@rango-dev/provider-trezor",
  "version": "0.28.1-next.1",
  "license": "MIT",
  "type": "module",
  "source": "./src/mod.ts",
  "main": "./dist/mod.js",
  "exports": {
    ".": "./dist/mod.js"
  },
  "typings": "dist/mod.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ../../scripts/build/command.mjs --path wallets/provider-trezor --splitting --inputs src/mod.ts",
    "ts-check": "tsc --declaration --emitDeclarationOnly -p ./tsconfig.json",
    "clean": "rimraf dist",
    "format": "prettier --write '{.,src}/**/*.{ts,tsx}'",
    "lint": "eslint \"**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@bitcoinerlab/secp256k1": "^1.2.0",
    "@hub3js/core": "^0.61.0",
    "@hub3js/evm": "^0.3.0",
    "@hub3js/std": "^0.2.0",
    "@rango-dev/signer-evm": "^0.43.0",
    "@rango-dev/wallets-shared": "^0.61.1-next.1",
    "@trezor/connect-web": "^9.5.0",
    "bitcoinjs-lib": "^6.1.7",
    "ethers": "^6.13.2",
    "rango-types": "^0.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}